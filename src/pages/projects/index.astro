---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  { title: 'Ethereal', description: 'A Mind Altering Experience.' },
  { title: 'Guillotine', description: 'Cutting Edge Technology.' },
  { title: '0xify', description: '***********', mono: true },
];
---

<BaseLayout title="Projects" description="Alexander Caesar's projects — Ethereal, Guillotine, and 0xify">
  <section class="page">
    <h1>Projects</h1>
    {
      projects.map((project) => (
        <div class="project">
          <h2 class={project.mono ? 'mono' : undefined}>{project.title}</h2>
          <p>{project.description}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .project {
    margin-top: var(--space-12);
  }

  .project h2 {
    margin: 0 0 var(--space-2);
  }

  /* Space Grotesk's "0" is a plain oval, indistinguishable from a capital "O" — monospace
     fonts give the zero a distinct shape, so titles containing one (e.g. "0xify") stay legible. */
  .project h2.mono {
    font-family: var(--font-mono);
  }

  .project p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
