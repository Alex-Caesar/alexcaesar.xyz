---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bio from '../components/Bio.astro';
import NavCard from '../components/NavCard.astro';
---

<BaseLayout
  title="Home"
  description="Alexander Caesar — software developer. Resume, blog, and ways to connect."
>
  <section class="hero">
    <h1 id="page-name">Alexander Caesar</h1>
    <p class="tagline">Art and Science across the Universe</p>
    <hr class="hero-divider" />
  </section>

  <Bio />

  <div class="discover-block">
    <h2 class="discover-label">Discover My Work</h2>
    <nav aria-label="Site sections" class="section-nav">
      <NavCard title="Ethereal" description="A Mind Altering Experience." />
      <NavCard title="Guillotine" description="Cutting Edge Technology." />
      <NavCard title="0xify" description="***********" />
    </nav>
  </div>
</BaseLayout>

<script>
  // A different gradient on the name every time the page loads (font stays fixed).
  const name = document.getElementById('page-name');
  if (name) {
    const isDark =
      document.documentElement.getAttribute('data-theme') === 'dark' ||
      (!document.documentElement.getAttribute('data-theme') &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);

    // Lightness is biased so the gradient stays legible against the off-white light
    // background and the near-black dark background, whatever hues get picked.
    const lightness = isDark ? 62 + Math.random() * 12 : 36 + Math.random() * 12;
    const hue1 = Math.random() * 360;
    const hue2 = (hue1 + 70 + Math.random() * 110) % 360;
    const angle = Math.floor(Math.random() * 360);

    name.style.backgroundImage = `linear-gradient(${angle}deg, hsl(${hue1.toFixed(0)} 85% ${lightness.toFixed(0)}%), hsl(${hue2.toFixed(0)} 85% ${lightness.toFixed(0)}%))`;
    name.style.backgroundClip = 'text';
    name.style.webkitBackgroundClip = 'text';
    name.style.color = 'transparent';
  }

  // Highlighter sweep — deliberately tied to an actual scroll gesture, not just visibility, so
  // anything already on screen at load reveals on first scroll rather than immediately, and
  // anything further down reveals once scrolled into view — same rule, both cases. Reduced-
  // motion users get every highlight instantly, no scroll needed. Currently only used in
  // Bio.astro (the "My passion is..." line), but this stays in the homepage script rather than
  // Bio.astro itself since document.querySelectorAll('.hl') already finds marks anywhere on
  // the rendered page, Bio included — no need to duplicate the observer per component.
  // A real marker moves at roughly constant speed, so a fixed transition-duration made longer
  // phrases sweep by too fast relative to their length and shorter ones drag. Setting the
  // duration from each mark's own rendered width (clamped to a sane range) instead keeps the
  // sweep's actual speed constant regardless of how much text it's covering.
  function setSweepDuration(el: HTMLElement) {
    const pxPerSecond = 280;
    const width = el.getBoundingClientRect().width;
    const duration = Math.min(1.8, Math.max(0.5, width / pxPerSecond));
    el.style.transitionDuration = `${duration.toFixed(2)}s`;
  }

  let pendingMarks = Array.from(document.querySelectorAll<HTMLElement>('.hl'));
  if (pendingMarks.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      pendingMarks.forEach((el) => el.classList.add('revealed'));
    } else {
      const revealVisible = () => {
        pendingMarks = pendingMarks.filter((el) => {
          const rect = el.getBoundingClientRect();
          const isVisible = rect.top < window.innerHeight * 0.85 && rect.bottom > 0;
          if (isVisible) {
            setSweepDuration(el);
            el.classList.add('revealed');
          }
          return !isVisible;
        });
        if (pendingMarks.length === 0) window.removeEventListener('scroll', onScroll);
      };

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          revealVisible();
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>

<style>
  /* #main lives in BaseLayout, not this page, but this scoped block only ships on the homepage
     bundle — so turning it into a flex column here doesn't touch any other page's layout. It
     lets .section-nav soak up leftover viewport height with auto margins below, centering the
     boxes+symbols in whatever empty space is left under the hero and bio instead of them just
     trailing the bio near the top of a tall page. */
  :global(#main) {
    display: flex;
    flex-direction: column;
  }

  .hero {
    /* #main above is a flex column, which makes .hero a flex item — and a flex item with
       auto left/right margins (for centering) does NOT stretch to fill the cross axis the way
       a plain block child would; the auto margins opt it out of stretch sizing entirely, so it
       shrank to fit its own content (the h1 text) instead of reaching the full 64rem. Explicit
       width:100% sidesteps that: it's resolved before max-width caps it, so margin:auto has a
       full 64rem box to center rather than a content-sized one. (.bio below only "worked"
       without this because its unwrapped paragraph text happened to be wide enough to hit the
       cap anyway — same underlying issue, just accidentally masked.) */
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4) var(--space-6);
    text-align: center;
  }

  .hero h1 {
    font-size: var(--font-size-4xl);
    margin: 0 0 var(--space-4);
  }

  .tagline {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    margin: 0;
  }

  /* Solid, not dashed — a deliberate contrast against the dashed elements elsewhere on the
     page. .hero and .bio share the same 64rem max-width, but not the same padding (1rem here
     vs. --space-6/1.5rem on .bio), so a plain 100% width was consistently ~0.5rem wider on
     each side than bio's actual content — this formula cancels that difference out (adds back
     .hero's own padding, then reapplies .bio's) so the line lands flush with the image's left
     edge and the text's right edge exactly, not just "roughly the same container". Uses
     --color-text rather than a literal black: that resolves to actual black in light theme,
     but flips to white in dark theme instead of vanishing against the near-black page
     background the way a hardcoded #000 would. */
  .hero-divider {
    width: calc(100% - 2 * (var(--space-6) - var(--space-4)));
    height: 2px;
    margin: var(--space-8) calc(var(--space-6) - var(--space-4)) 0;
    border: none;
    background: var(--color-text);
  }

  .discover-block {
    /* Carries the auto margins .section-nav used to hold on its own, now that there's a label
       above it too — still soaks up leftover viewport height the same way, just centering the
       label+cards pair together instead of the cards alone. */
    margin-top: auto;
    margin-bottom: auto;
    text-align: center;
  }

  .discover-label {
    margin: 0 0 var(--space-4);
    color: var(--color-link);
    font-size: var(--font-size-2xl);
    font-weight: 700;
  }

  .section-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-4);
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  /* Portrait phones only: stack the boxes. Landscape ("horizontal view") skips this block
     entirely, so a rotated phone falls back to the normal row layout. */
  @media (max-width: 40rem) and (orientation: portrait) {
    .section-nav {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
