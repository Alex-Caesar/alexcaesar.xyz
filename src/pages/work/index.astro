---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  { title: 'Ethereal', description: 'A Mind Altering Experience.' },
  { title: 'Guillotine', description: 'Cutting Edge Technology.' },
  { title: 'Untitled #1', description: 'To be discovered...' },
];
---

<BaseLayout title="Work" description="Alexander Caesar's work — Ethereal, Guillotine, and 0xify">
  <section class="page">
    <h1>Work</h1>
    {
      projects.map((project) => (
        <div class="project">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .project {
    margin-top: var(--space-12);
  }

  .project h2 {
    margin: 0 0 var(--space-2);
  }

  .project p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
