---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import ListenButton from '../components/ListenButton.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  coverImage?: ImageMetadata;
  coverImageAlt?: string;
}

const { title, description, pubDate, tags, coverImage, coverImageAlt } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header>
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </p>
      <TagList tags={tags} />
      <ListenButton targetId="post-body" />
    </header>

    {
      coverImage && (
        <Image src={coverImage} alt={coverImageAlt ?? ''} width={1200} height={630} class="post-cover" />
      )
    }

    <div id="post-body" class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
  }

  .post-meta {
    color: var(--color-text-muted);
    margin: var(--space-2) 0 var(--space-4);
  }

  header :global(.listen-button) {
    margin-top: var(--space-4);
  }

  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius);
  }

  .post-body {
    margin-top: var(--space-6);
    line-height: var(--line-height-base);
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-4);
  }

  .post-body :global(h2) {
    margin: var(--space-8) 0 var(--space-4);
    font-size: var(--font-size-xl);
  }

  .post-body :global(h3) {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--font-size-lg);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }

  .post-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-body :global(blockquote) {
    margin: var(--space-6) 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-border);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-6) 0;
    border-radius: var(--radius);
  }

  .post-body :global(figure) {
    margin: var(--space-6) 0;
  }

  .post-body :global(figure img) {
    margin: 0 0 var(--space-2);
  }

  .post-body :global(figcaption) {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .post-body :global(pre) {
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: var(--font-size-sm);
  }

  .post-body :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 0.25em;
    background: var(--color-bg-raised);
    font-size: 0.9em;
  }

  .post-body :global(table) {
    width: 100%;
    margin: 0 0 var(--space-4);
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
  }
</style>
