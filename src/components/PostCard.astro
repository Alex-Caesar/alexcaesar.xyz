---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  coverImage?: ImageMetadata;
  coverImageAlt?: string;
}

const { href, title, description, pubDate, tags, coverImage, coverImageAlt } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-card">
  {
    coverImage && (
      <a href={href} class="post-card-image" tabindex="-1" aria-hidden="true">
        <Image src={coverImage} alt="" width={240} height={135} />
      </a>
    )
  }
  <div class="post-card-body">
    <h2><a href={href}>{title}</a></h2>
    <p class="post-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </p>
    <p class="post-description">{description}</p>
    <TagList tags={tags} />
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card-image {
    flex-shrink: 0;
    display: block;
    width: 8rem;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .post-card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-body {
    min-width: 0;
    flex: 1;
  }

  .post-card h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-xl);
  }

  .post-card h2 a {
    text-decoration: none;
    color: var(--color-text);
  }

  .post-card h2 a:hover {
    color: var(--color-link-hover);
  }

  .post-meta {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .post-description {
    margin: 0 0 var(--space-3);
  }
</style>
