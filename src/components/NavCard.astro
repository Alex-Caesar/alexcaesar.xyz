---
interface Props {
  href?: string;
  title: string;
  description: string;
  mono?: boolean;
}

const { href, title, description, mono } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="nav-card" href={href}>
  <h2 class={mono ? 'mono' : undefined}>{title}</h2>
  <p>{description}</p>
</Tag>

<style>
  .nav-card {
    display: block;
    width: 16rem;
    box-sizing: border-box;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease;
  }

  .nav-card:hover {
    border-color: var(--color-purple-500);
  }

  .nav-card h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
    color: var(--color-link);
  }

  /* Space Grotesk's "0" is a plain oval, indistinguishable from a capital "O" — monospace
     fonts give the zero a distinct shape, so titles containing one (e.g. "0xify") stay legible. */
  .nav-card h2.mono {
    font-family: var(--font-mono);
  }

  .nav-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
