---
import { Image } from 'astro:assets';
import meProfile from '../assets/images/me-profile.png';
---

<section class="bio" aria-labelledby="bio-heading">
  <Image src={meProfile} alt="Portrait of Alexander Caesar" width={480} height={640} loading="eager" class="bio-image" />
  <div class="bio-text">
    <h2 id="bio-heading">Profile</h2>
    <p>
      I have always been drawn to building things, from my childhood constructing Lego creations to
      delving into Software Development on a Raspberry Pi at the age of 13 with the guidance of my
      Dad.
    </p>
    <p>
      During my teenage years, I also explored music, video, and game production. I do not ever want
      to stop learning and making.
    </p>
    <p>
      As an avid user of technology, I like technology that works but I LOVE technology that "just
      works" out the box with top-notch performance and efficiency right out of the box, regardless of
      the environment.
    </p>
    <p>
      <span class="hl">My passion is Enabling, Automating, and Integrating Tools or Technologies with excellence to
      help make products or services that "just work".</span>
    </p>
    <p>
      At an organizational level, I want to instill a culture of continuous improvement to drive
      business growth and refine the developer experience.
    </p>
    <p>
      <strong>My goal</strong> is to explore all that the world has to offer while spreading hope and
      helping people climb
      <a href="https://www.simplypsychology.org/maslow.html"> Maslow's Hierarchy of Needs</a>.
    </p>
  </div>
</section>

<style>
  .bio {
    /* This page's #main is a flex column (see index.astro), making .bio a flex item — a flex
       item with auto left/right margins (for centering) doesn't stretch to fill the cross axis
       the way a plain block child would, so without an explicit width this shrinks to fit its
       own content instead of reaching the full 64rem. It happened to still hit 64rem in
       practice because the unwrapped paragraph text was wide enough to hit the cap anyway —
       explicit width:100% makes that reliable instead of incidental. */
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: flex-start;
    max-width: 64rem;
    margin: var(--space-6) auto var(--space-12);
    padding: var(--space-6);
  }

  /* Was a fixed 15rem thumbnail dwarfed by the flexibly-growing text column next to it — now
     sized on equal footing (same flex-basis, same grow factor as .bio-text) so the two columns
     land at roughly comparable widths instead of one being a small fixed-size photo beside a
     much wider text block. Capped at 24rem so it doesn't overshoot into a wall-sized portrait on
     very wide viewports. */
  .bio-image {
    border-radius: var(--radius);
    flex: 1 1 20rem;
    max-width: 24rem;
    width: 100%;
    height: auto;
  }

  .bio-text {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .bio-text h2 {
    margin-top: 0;
    text-align: center;
  }

  .bio-text p {
    margin: 0 0 var(--space-4);
  }

  /* Highlighter sweep: a background rectangle sized to 0% width at rest, animated to 100%
     once revealed (see the homepage's script — document.querySelectorAll('.hl') there already
     picks up marks anywhere on the page, this component included). The span gets its own
     tighter line-height first — the page's looser line-height (var(--line-height-base), 1.6)
     would otherwise put the 78%/88% position/size percentages somewhere in the extra leading
     instead of against the actual glyphs, cutting off cap-height tops and descenders. Unlike
     the tagline's earlier use of this, paragraph text here is already --color-text (not a
     muted shade), so no color override is needed for contrast against the highlight. */
  .bio-text .hl {
    line-height: 1.15;
    background-image: linear-gradient(var(--color-highlight) 0 0);
    background-repeat: no-repeat;
    background-position: 0 78%;
    background-size: 0% 88%;
    padding: 0 0.05em;
    margin: 0 -0.05em;
    transition-property: background-size;
    transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-duration: 0.7s;
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-text .hl {
      transition-duration: 0s;
    }
  }

  .bio-text .hl.revealed {
    background-size: 100% 88%;
  }
</style>
